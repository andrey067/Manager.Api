# PostgreSQL connection string (async app converts to asyncpg at runtime).
# Examples:
#   postgresql+psycopg2://user:password@localhost:5432/manager_api_python
#   postgresql://user:password@localhost:5432/manager_api_python
# URL-encode special characters in the password (e.g. @ → %40, # → %23, $ → %24).
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/manager_api_python

# JWT (required) — use a long random secret in production; never commit real secrets.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ISSUER=Manager.API
JWT_AUDIENCE=Manager.API
JWT_HOURS_TO_EXPIRE=1
JWT_ALGORITHM=HS256

# Argon2 password hashing (mirrors .NET Hash settings)
HASH_TIME_COST=10
HASH_LANES=5
HASH_MEMORY_COST=32768
HASH_LENGTH=32
